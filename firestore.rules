rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Admins (operational data: pipeline_runs) — a strict subset of founders.
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email == "crnarendran@gmail.com";
    }
    // Founders are grandfathered premium (both co-founders).
    function isFounderEmail() {
      return isSignedIn() && (
        request.auth.token.email == "crnarendran@gmail.com"
        || request.auth.token.email == "mvsaikishore@gmail.com"
      );
    }
    // Premium entitlement gates creating your own companies/materials (SM-42).
    // Founders are grandfathered; everyone else needs an entitlement doc
    // (written only by the backend / admin — e.g. a license grant or billing
    // webhook). Free users can still view companies shared with them.
    function isPremium() {
      return isSignedIn() && (
        isFounderEmail()
        || (exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            && get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
                 .data.plan == 'premium')
      );
    }

    // Per-user plan/entitlement. User reads their own; backend/admin writes.
    match /entitlements/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Per-user private settings (personalization, weights, view state).
    // A user reads/writes ONLY their own document (keyed by uid).
    match /user_settings/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Companies live in env-partitioned collections (SM-44): companies (prod),
    // companies_staging, companies_dev. Same access model for all three — the
    // guard keeps this match from affecting any other collection.
    function isCompaniesCol(c) {
      return c == 'companies'
        || c == 'companies_staging'
        || c == 'companies_dev';
    }

    // Companies + their materials (BOMs). The owner has full control; a user
    // whose uid is in `viewerUids` (via an accepted invitation, SM-41) gets
    // read-only access. Writes stay owner-only; the accept flow adds viewers
    // through a trusted Admin-SDK callable, not client writes.
    match /{companiesCol}/{companyId} {
      allow read: if isCompaniesCol(companiesCol) && isSignedIn() && (
        request.auth.uid == resource.data.ownerUid
        || request.auth.uid in resource.data.get('viewerUids', [])
      );
      allow update, delete: if isCompaniesCol(companiesCol) && isSignedIn()
        && request.auth.uid == resource.data.ownerUid;
      // Creating your own company requires a premium entitlement (SM-42).
      allow create: if isCompaniesCol(companiesCol) && isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isPremium();

      match /materials/{materialId} {
        function company() {
          return get(
            /databases/$(database)/documents/$(companiesCol)/$(companyId)
          ).data;
        }
        allow read: if isCompaniesCol(companiesCol) && isSignedIn() && (
          request.auth.uid == company().ownerUid
          || request.auth.uid in company().get('viewerUids', [])
        );
        allow write: if isCompaniesCol(companiesCol) && isSignedIn()
          && request.auth.uid == company().ownerUid;
      }
    }

    // Invitations: the owner reads their own; only the backend (Admin SDK,
    // which bypasses rules) writes them. No client writes, no public listing.
    match /invitations/{inviteId} {
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Reporting + monitor collections. Commodity prices are the same public
    // newsletter data for every signed-in user (SM-41), so historical_prices
    // is readable by any authenticated user; pipeline_runs (operational)
    // stays admin-only. All writes are backend-only.
    match /{collection}/{document=**} {
      allow read: if isSignedIn() && (
        collection.matches('^historical_prices.*')
        || (collection.matches('^pipeline_runs.*') && isAdminEmail())
      );
      allow write: if false;
    }
  }
}
