rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      // Allow the dashboard owner to read the monitor (pipeline_runs*) and the
      // reporting collections (historical_prices*).
      allow read: if (collection.matches('^pipeline_runs.*') || collection.matches('^historical_prices.*')) && request.auth != null && request.auth.token.email == "crnarendran@gmail.com";
      // Only backend functions can write
      allow write: if false; 
    }
  }
}
